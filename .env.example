# Clé API OpenWebUI (requise)
OPENWEBUI_API_KEY=votre_cle_api_ici

# URL de base OpenWebUI par défaut (optionnel, peut être remplacé par l'utilisateur)
DEFAULT_OPENWEBUI_URL=https://votre-instance-openwebui.fr/

# ID client Google pour l'authentification SSO (optionnel)
GOOGLE_CLIENT_ID=votre_client_id_google.apps.googleusercontent.com

# Domaines autorisés pour l'authentification Google (séparés par des virgules)
GOOGLE_ALLOWED_DOMAINS=domaine1.com,domaine2.com

# Informations d'auth Keycloak
KEYCLOAK_ISSUER=https://your-keycloak-server/realms/your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_REDIRECT_URI=https://your-app-url/auth/callback